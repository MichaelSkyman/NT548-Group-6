# Local development only. Copy to .env and choose your own password.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devops_learning
DB_USERNAME=devops_app
DB_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
DB_SSLMODE=disable
DB_CONNECT_TIMEOUT=10
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Optional: overrides the fields above. URL-encode special characters in credentials.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/devops_learning
# Production: DB_SSLMODE=verify-full and DB_SSLROOTCERT=/certs/global-bundle.pem
