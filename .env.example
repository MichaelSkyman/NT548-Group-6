# Local development only. Copy to .env and choose your own values.
#   cp .env.example .env
# Chạy cả hệ thống bằng docker compose (xem compose.yaml):
#   docker compose up -d --build   ->   http://localhost:8080
# Compose tự đặt DB_HOST=postgres và DB_SSLMODE=disable cho container,
# nên DB_HOST bên dưới chỉ dùng khi chạy backend trực tiếp trên máy (python run.py).
# Bắt buộc phải điền cho compose: DB_PASSWORD, SECRET_KEY, JWT_SECRET_KEY, ADMIN_PASSWORD.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devops_learning
DB_USERNAME=devops_app
DB_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
DB_SSLMODE=disable
DB_CONNECT_TIMEOUT=10
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Optional: overrides the fields above. URL-encode special characters in credentials.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/devops_learning
# Production: DB_SSLMODE=verify-full and DB_SSLROOTCERT=/certs/global-bundle.pem

SECRET_KEY=change-me-to-a-long-random-value
JWT_SECRET_KEY=change-me-to-a-different-long-random-value
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
QUIZ_SIZE=15
QUIZ_TOKEN_MAX_AGE=3600
# seed.py creates an admin only when ADMIN_PASSWORD is explicitly set (docker compose requires it).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_MIN_12_CHARS
